<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><solid android:color="#FF1C1C1C" /><corners android:radius="4dp" /><stroke android:width="1dp" android:color="@color/stroke" /></shape></item>
            <item android:gravity="bottom" android:height="2dp" android:left="1dp" android:right="1dp"><shape><solid android:color="@color/accent" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#FF2D2D2D" /><corners android:radius="4dp" /><stroke android:width="1dp" android:color="@color/stroke" /></shape></item>
            <item android:gravity="bottom" android:height="1dp" android:left="1dp" android:right="1dp"><shape><solid android:color="#FF9A9A9A" /></shape></item>
        </layer-list>
    </item>
</selector>
