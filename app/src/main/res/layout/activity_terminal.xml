<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome"
    android:orientation="vertical">

    <!-- Tab row, Windows Terminal style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp">

        <HorizontalScrollView
            android:id="@+id/tabs_scroll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/new_tab"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Nouvel onglet"
            android:src="@drawable/ic_add" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/terminal_bg">

        <com.termux.view.TerminalView
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollbarThumbVertical="@drawable/scrollbar"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/disconnected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="8dp"
            android:background="@drawable/bg_dialog"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/disconnected_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Déconnecté"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Button android:id="@+id/close_tab" style="@style/ButtonSubtle" android:layout_height="36dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Fermer" />
            <Button android:id="@+id/reconnect" style="@style/ButtonAccent" android:layout_height="36dp" android:layout_marginStart="8dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Reconnecter" />
        </LinearLayout>
    </FrameLayout>

    <com.nico7an.terminal.ExtraKeysView
        android:id="@+id/extra_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chrome" />
</LinearLayout>
